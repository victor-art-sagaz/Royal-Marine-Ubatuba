{
  // Configuração do site na Cloudflare (Workers).
  // • "worker/index.js" busca a previsão no Open-Meteo usando a chave guardada na Cloudflare (OPEN_METEO_KEY).
  // • "single-page-application" faz qualquer endereço do site (ex.: /tabua-de-mare) abrir a página certa,
  //   mesmo quando a pessoa entra direto pelo link ou atualiza a página.
  "name": "royal-marine-ubatuba",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
